<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OtoCAD.Avalonia"
        x:Class="OtoCAD.Avalonia.Dialogs.ImportSelectionDialog"
        Title="导入光学设计" Width="960" Height="620" MinWidth="330" MinHeight="310"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <StackPanel>
      <TextBlock Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <Expander Name="ImportDetails" Header="跳过项与导入提示" IsVisible="False" IsExpanded="True"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,3,0,3" Padding="4,2">
        <ScrollViewer Name="DetailsScroll" MaxHeight="100" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock Name="ImportDetailsText" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Expander>
    </StackPanel>
    <Grid Name="Body" Grid.Row="1" ColumnDefinitions="*,*">
      <Border Name="PreviewPanel" Classes="workbenchCard" ClipToBounds="True" Padding="4">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Name="PreviewTitle" Text="光路预览" Margin="5,1" FontSize="12"/>
          <local:CadCanvas Grid.Row="1" Name="PreviewCanvas"/>
          <TextBlock Grid.Row="1" Name="PreviewMessage" TextWrapping="Wrap" Margin="6" VerticalAlignment="Center"
                     HorizontalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Border Name="SelectionPanel" Grid.Column="1" Margin="4,0,0,0" Classes="workbenchCard" Padding="7">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,5">
            <TextBlock Name="CountText" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Name="SelectAllBtn" Content="全选"/>
            <Button Grid.Column="2" Name="SelectNoneBtn" Content="全不选"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Name="ItemsPanel" Spacing="6"/></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
      <CheckBox Name="LayoutTabCheck" Content="另生成光路总览" IsChecked="False"/>
      <Grid Grid.Row="1" Margin="0,4,0,0" ColumnDefinitions="*,Auto,Auto">
        <TextBlock Name="ValidationText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Name="CancelBtn" Content="取消" IsCancel="True"/>
        <Button Grid.Column="2" Name="OkBtn" Margin="5,0,0,0" Content="生成加工图" Classes="primary" IsDefault="True"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
